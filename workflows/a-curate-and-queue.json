    {
      "parameters": {
        "jsCode": "// ── 把 20 篇論文合成「候選清單」給 AI Agent（附 arXiv ID 讓它呼叫工具）──\nconst items = $input.all();\n\nconst list = items.map((it, i) => {\n  const d = it.json;\n  // 從 link 抽出 arXiv ID（http://arxiv.org/abs/2609.12345v1 → 2609.12345）\n  const m = (d.link || '').match(/abs\\/([^v]+)/);\n  return (i + 1) + '. ' + d.title + ' (ID: ' + (m ? m[1] : '?') + ')';\n});\n\nconst today = new Date().toLocaleDateString('zh-TW', { timeZone: 'Asia/Taipei' });\n\nconst prompt = '今天的日期：' + today\n  + '\\n\\n以下是今日 arXiv 的 AI 論文候選清單（共 ' + items.length + ' 篇）：\\n\\n'\n  + list.join('\\n');\n\nreturn [{ json: { prompt: prompt, count: items.length } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -304,
