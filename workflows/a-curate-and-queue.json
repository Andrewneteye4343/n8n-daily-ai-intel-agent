    {
      "parameters": {
        "jsCode": "// ── 解析 AI Agent 輸出 → 每篇論文一個 item（準備寫入待核准佇列）──\nconst out = $input.first().json.output || '';\n\n// 以「【第N篇】」為分隔切開\nconst blocks = out.split(/【第\\s*\\d+\\s*篇】/).slice(1);\n\nconst createdAt = new Date().toISOString();\n\nconst get = (block, label) => {\n  const m = block.match(new RegExp(label + '[:：]\\\\s*(.+)'));\n  return m ? m[1].trim() : '';\n};\n\nconst items = blocks.map((b) => {\n  const scoreRaw = get(b, '評分');\n  const score = parseFloat(scoreRaw);\n  return {\n    json: {\n      title: get(b, '標題'),\n      link: get(b, '連結'),\n      summary: get(b, '重點'),\n      score: isNaN(score) ? 0 : score,\n      tag: get(b, '標籤'),\n      status: 'pending',          // ← 新進佇列一律 pending\n      created_at: createdAt,\n    }\n  };\n});\n\nreturn items;\n"
      },
      "type": "n8n-nodes-base.code",
