      "parameters": {
        "jsCode": "// ── 把 n8n 的錯誤資訊整理成人看得懂的告警 ──\nconst e = $input.first().json;\n\nconst wf = (e.workflow && e.workflow.name) || '未知工作流';\nconst ex = e.execution || {};\nconst errMsg = (ex.error && ex.error.message) || '未知錯誤';\n\nconst time = new Date().toLocaleString('zh-TW', {\n  timeZone: 'Asia/Taipei', hour12: false\n});\n\nconst message = '🚨 n8n 工作流失敗告警\\n\\n'\n  + '工作流：' + wf + '\\n'\n  + '失敗節點：' + (ex.lastNodeExecuted || '?') + '\\n'\n  + '錯誤訊息：' + String(errMsg).slice(0, 300) + '\\n'\n  + '時間：' + time + '\\n'\n  + '執行紀錄：' + (ex.url || '(無)');\n\nreturn [{ json: { message: message } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
