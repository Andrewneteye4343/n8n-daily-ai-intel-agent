    {
      "parameters": {
        "jsCode": "// ── 把「已核准」的論文組成 Telegram 訊息 ──\nconst rows = $input.all().map(it => it.json);\n\nconst today = new Date().toLocaleDateString('zh-TW', {\n  timeZone: 'Asia/Taipei', year: 'numeric', month: '2-digit', day: '2-digit'\n});\n\nconst lines = rows.map((r, i) =>\n  (i + 1) + '. [' + r.score + '★] ' + r.title + '\\n' + r.summary + '\\n' + r.link\n);\n\nconst message = '✅ 人工核准推播 · ' + today + '（' + rows.length + ' 篇）\\n\\n'\n  + lines.join('\\n\\n');\n\nreturn [{ json: { message: message, count: rows.length } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
